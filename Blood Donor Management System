}
void search()
{
    int choice;
    cout << "1. Blood Group\n2. City\n3. Donor ID\n";
    cin >> choice;
    if (choice == 1) searchDonorByBloodGroup();
    else if (choice == 2) searchDonorByCity();
    else if (choice == 3) searchDonorByID();
    else cout << "Invalid choice.\n";
}
bool validnumber(string number)
{
    if (number.length() != 11)
    {
        cout << "Contact number must be 11 digits.\n";
        return false;
    }
    for (char c : number)
    {
        if (!isdigit(c))
        {
            cout << "Contact number must contain digits only.\n";
            return false;
        }
    }
    for (int i = 0; i < donors.size(); i++)
    {
        if (donors[i].contactNumber == number)
        {
            cout << "Contact number already exists.\n";
            return false;
        }
    }
    return true;
}
void updateDonor()
{
    int id;
    cout << "Enter Donor ID to update: ";
    cin >> id;
    for (int i = 0; i < donors.size(); i++)
    {
        if (donors[i].donorID == id)
        {
            int choice;
            cout << "1. Contact Number\n2. City\n3. Age\n4. Last Donation Date\n";
            cin >> choice;

            if (choice == 1)
            {
                string num;
                cout << "Enter new number: ";
                cin >> num;
                if (validnumber(num)) donors[i].contactNumber = num;
            }
            else if (choice == 2)
            {
                cout << "Enter new city: ";
                cin >> donors[i].city;
            }
            else if (choice == 3)
            {
                int age;
                cout << "Enter new age: ";
                cin >> age;
                if (age >= 18 && age <= 60) donors[i].age = age;
            }
            else if (choice == 4)
            {
                cout << "Enter new date: ";
                cin >> donors[i].lastDonationDate;
                donors[i].donationCount++;
            }
            cout << "Record updated.\n";
            return;
        }
    }
    cout << "Donor not found.\n";
}
void deleteDonor()
{
    int id;
    cout << "Enter Donor ID to delete: ";
    cin >> id;
    for (int i = 0; i < donors.size(); i++)
    {
        if (donors[i].donorID == id)
        {
            donors.erase(donors.begin() + i);
            cout << "Donor deleted.\n";
            return;
        }
    }
    cout << "Donor not found.\n";
}
