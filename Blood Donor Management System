void searchDonorByBloodGroup()
{
    string bg;
    int count = 0;
    cout << "Enter Blood Group: ";
    cin >> bg;
    for (int i = 0; i < donors.size(); i++)
    {
        if (donors[i].bloodGroup == bg)
        {
            cout << "ID: " << donors[i].donorID << " Name: " << donors[i].name << endl;
            count++;
        }
    }
    cout << "Total donors found: " << count << endl;
}
void searchDonorByCity()
{
